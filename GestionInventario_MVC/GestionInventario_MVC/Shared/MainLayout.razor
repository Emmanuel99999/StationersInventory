@using System.Security.Claims
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider


<PageTitle>GestionInventario_MVC</PageTitle>

@* --- INICIO: AÑADIR PROVEEDORES MUD BLAZOR --- *@
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider /> @* <-- EL QUE FALTABA *@
@* --- FIN: AÑADIR PROVEEDORES MUD BLAZOR --- *@
@code {
    private ClaimsPrincipal usuario;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        usuario = authState.User;
    }
}
<div class="page">
    <div class="sidebar">
        <nav>
            <ul>
                <li>
                    <NavLink href="/" Match="NavLinkMatch.All" class="@GetNavLinkClass("/")">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Class="nav-icon" />
                        Inicio
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/inventory" class="@GetNavLinkClass("/inventory")">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="nav-icon" />
                        Inventario
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/compras" class="@GetNavLinkClass("/compras")">
                         <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="nav-icon" />
                                Compras
                     </NavLink>
                </li>
                <li>
                    <NavLink href="/Users/ChangePassword" class="@GetNavLinkClass("/Users/ChangePassword")">
                        <MudIcon Icon="@Icons.Material.Filled.VpnKey" Class="nav-icon" />
                        Cambiar contraseña
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/Users/EditProfile" class="@GetNavLinkClass("/Users/EditProfile")">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="nav-icon" />
                        Editar perfil
                    </NavLink>
                </li>

                <!-- Agrega más enlaces de administración aquí -->


                @* SOLO para admins autenticados *@
                @if (usuario.Identity.IsAuthenticated && usuario.IsInRole("Administrador"))
                {
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/Roles/Index">
                                <i class="bi bi-person-gear"></i> Gestión de Roles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/UserRoles/Assign">
                                <i class="bi bi-shield-shaded"></i> Asignar Roles
                            </a>
                        </li>
                    </ul>
                }
                <li>
                    <a href="/home/logout" class="@GetNavLinkClass("/home/logout") nav-link">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="nav-icon" />
                        Cerrar sesión
                    </a>
                </li>
            </ul>
        </nav>
    </div>

    <main>
        <article>
            @Body
        </article>
    </main>
</div>

@code {
    private string GetNavLinkClass(string path)
    {
        return NavigationManager.Uri.EndsWith(path) ? "active" : "";
    }
    private async Task DoLogout()
    {
        // JavaScript interop para enviar el formulario de logout
        await JS.InvokeVoidAsync("submitLogoutForm");
    }
}

@* Los estilos CSS permanecen igual que en la versión anterior *@
<style>

    .page {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }


    .sidebar {
        width: 150px;
        min-height: 100vh;
        background: linear-gradient(180deg, #0575E6 0%, #0252a8 100%);
        padding: 1.5rem 0;
        position: sticky;
        top: 0;
        box-shadow: 5px 0 10px -5px rgba(0, 193, 255, 0.3), inset -1px 0 0 rgba(255, 255, 255, 0.1);
    }


        .sidebar nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }


        .sidebar nav li {
            margin: 0;
            padding: 0.25rem 1rem;
        }


            .sidebar nav li a {
                display: flex;
                align-items: center;
                padding: 0.75rem 1rem;
                color: rgba(255, 255, 255, 0.95) !important;
                text-decoration: none !important;
                border-radius: 6px;
                transition: all 0.25s ease;
                font-size: 0.95rem;
                font-weight: 500;
            }

                .sidebar nav li a:hover {
                    background-color: rgba(255, 255, 255, 0.15) !important;
                    transform: translateX(5px);
                }


                .sidebar nav li a.active {
                    background-color: rgba(255, 255, 255, 0.25) !important;
                    font-weight: 600;
                    box-shadow: inset 4px 0 0 white;
                }


</style>