@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor 

<PageTitle>GestionInventario_MVC</PageTitle>

@* --- INICIO: AÑADIR PROVEEDORES MUD BLAZOR --- *@
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider /> @* <-- EL QUE FALTABA *@
@* --- FIN: AÑADIR PROVEEDORES MUD BLAZOR --- *@

<div class="page">
    <div class="sidebar">
        <nav>
            <ul>
                <li>
                    <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                </li>
                <li>
                    <NavLink href="/inventory">Inventario</NavLink>
                </li>
            </ul>
        </nav>
    </div>
    <main>
        <article>
            @Body
        </article>
    </main>
</div>

@* Los estilos CSS permanecen igual que en la versión anterior *@
<style>
    .page {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        background-color: #f4f7fa;
    }

    .sidebar {
        width: 200px;
        background-color: #0575E6;
        padding: 1rem;
        font-size: 1.3rem;
        border-right: 1px solid #dee2e6;
        color: white !important;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.05);
        font-family: 'Segoe UI', sans-serif;
    }

        .sidebar nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar nav li {
            margin-bottom: 1rem;
            color:red;
        }

            .sidebar nav li .nav-link {
                display: block;
                padding: 0.5rem 0.75rem;
                color: white ;
                border-radius: 6px;
                font-weight: 500;
                transition: all 0.2s ease-in-out;
            }

                .sidebar nav li .nav-link.active {
                    color: white;
                    background-color: #0d6efd;
                    font-weight: bold;
                }

                .sidebar nav li .nav-link:not(.active):hover {
                    background-color: #2e557a;
                    color: white;
                }

    article {
        padding: 2rem;
        flex: 1;
    }

</style>