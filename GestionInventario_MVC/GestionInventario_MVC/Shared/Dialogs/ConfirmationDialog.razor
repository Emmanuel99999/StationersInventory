@using MudBlazor
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="@ButtonColor" OnClick="() => MudDialog.Close(DialogResult.Ok(true))">@SubmitButtonText</MudButton>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

<Component />