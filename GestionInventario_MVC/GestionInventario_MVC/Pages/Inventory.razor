@page "/inventory"
@inject IProductService ProductService
@using System.Diagnostics

<PageTitle>Gestión de Inventario</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Gestión de Inventario</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <EditForm Model="@newProduct" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProduct.Name"
                              Label="Nombre del producto"
                              Variant="Variant.Outlined"
                              For="@(() => newProduct.Name)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProduct.Category"
                              Label="Categoría"
                              Variant="Variant.Outlined"
                              For="@(() => newProduct.Category)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                @* --- SINTAXIS CORREGIDA --- *@
                <MudNumericField T="int" @bind-Value="newProduct.Stock"
                                 Label="Stock"
                                 Variant="Variant.Outlined"
                                 For="@(() => newProduct.Stock)" />
                @* --- FIN CORRECCIÓN --- *@
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProduct.Barcode"
                              Label="Código de barras"
                              Variant="Variant.Outlined"
                              For="@(() => newProduct.Barcode)" />
            </MudItem>
            <MudItem xs="12" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Guardar</MudButton>
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>

@* Las tablas y el @code block permanecen igual que en la versión anterior donde se añadieron los Console.WriteLine *@
<MudText Typo="Typo.h5" GutterBottom="true">Productos</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@products" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Código de barras</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="Categoría">@context.Category</MudTd>
            <MudTd DataLabel="Stock">@context.Stock</MudTd>
            <MudTd DataLabel="Código de barras">@context.Barcode</MudTd>
            <MudTd DataLabel="Acciones">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditProduct(context)" Color="Color.Primary" Title="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => DeleteProduct(context.Id)" Color="Color.Error" Title="Eliminar" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay productos para mostrar.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudText Typo="Typo.h5" GutterBottom="true">Historial de Movimientos</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@movements" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh>Fecha</MudTh>
            <MudTh>Producto ID</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh>Tipo</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Fecha">@context.Date.ToShortDateString()</MudTd>
            <MudTd DataLabel="Producto ID">@context.ProductId</MudTd>
            <MudTd DataLabel="Cantidad">@context.Quantity</MudTd>
            <MudTd DataLabel="Tipo">@context.Type</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay movimientos para mostrar.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>


@code {
    private Product newProduct = new();
    private IEnumerable<Product> products = new List<Product>();
    private IEnumerable<InventoryMovement> movements = new List<InventoryMovement>();

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("Inventory.razor: OnInitializedAsync iniciando.");
        await LoadData();
        Console.WriteLine("Inventory.razor: OnInitializedAsync completado.");
    }

    private async Task LoadData()
    {
        try
        {
            Console.WriteLine("Inventory.razor: LoadData iniciando.");
            products = await ProductService.GetProductsAsync() ?? new List<Product>();
            movements = await ProductService.GetInventoryMovementsAsync(0) ?? new List<InventoryMovement>();
            Console.WriteLine($"Inventory.razor: LoadData completado. Productos: {products.Count()}, Movimientos: {movements.Count()}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en LoadData: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        Console.WriteLine("HandleValidSubmit: Iniciando...");
        Console.WriteLine($"Valores a guardar: ID={newProduct.Id}, Nombre='{newProduct.Name}', Categoria='{newProduct.Category}', Stock={newProduct.Stock}, Barcode='{newProduct.Barcode}'");

        if (string.IsNullOrWhiteSpace(newProduct.Name) || string.IsNullOrWhiteSpace(newProduct.Category))
        {
            Console.WriteLine("HandleValidSubmit: Error - Nombre y Categoría son requeridos.");
            return;
        }

        try
        {
            if (newProduct.Id == 0)
            {
                Console.WriteLine("HandleValidSubmit: Llamando a AddProductAsync...");
                await ProductService.AddProductAsync(newProduct);
                Console.WriteLine("HandleValidSubmit: AddProductAsync completado.");
            }
            else
            {
                Console.WriteLine($"HandleValidSubmit: Llamando a UpdateProductAsync para ID: {newProduct.Id}...");
                await ProductService.UpdateProductAsync(newProduct);
                Console.WriteLine("HandleValidSubmit: UpdateProductAsync completado.");
            }

            newProduct = new Product();
            Console.WriteLine("HandleValidSubmit: Formulario limpiado.");
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"HandleValidSubmit: EXCEPCIÓN al guardar: {ex.ToString()}");
        }
    }

    private void EditProduct(Product product)
    {
        Console.WriteLine($"EditProduct: Editando producto ID: {product.Id}, Nombre: {product.Name}");
        newProduct = new Product
            {
                Id = product.Id,
                Name = product.Name,
                Category = product.Category,
                Stock = product.Stock,
                Barcode = product.Barcode
            };
    }

    private async Task DeleteProduct(int id)
    {
        Console.WriteLine($"DeleteProduct: Intentando eliminar producto ID: {id}");
        try
        {
            await ProductService.DeleteProductAsync(id);
            Console.WriteLine($"DeleteProduct: Producto ID: {id} eliminado.");
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DeleteProduct: EXCEPCIÓN al eliminar ID: {id}. Error: {ex.Message}");
        }
    }
}