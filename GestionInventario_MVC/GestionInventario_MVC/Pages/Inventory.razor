@page "/inventory"
@inject IProductService ProductService
@inject ISnackbar Snackbar

@* @using GestionInventario_MVC.Exceptions NO es necesario aquí si solo la capturas *@

@* <PageTitle>Gestión de Inventario</PageTitle> *@

<MudText Typo="Typo.h4" GutterBottom="true">Gestión de Inventario</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <EditForm Model="@newProduct" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
        <DataAnnotationsValidator />

        <MudGrid Spacing="2">
            @* --- Campos del formulario (igual que antes, con ValidationMessage) --- *@
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProduct.Name" Label="Nombre del producto" Variant="Variant.Outlined" For="@(() => newProduct.Name)" />
                <ValidationMessage For="@(() => newProduct.Name)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProduct.Category" Label="Categoría" Variant="Variant.Outlined" For="@(() => newProduct.Category)" />
                <ValidationMessage For="@(() => newProduct.Category)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="newProduct.Stock" Label="Stock" Variant="Variant.Outlined" For="@(() => newProduct.Stock)" />
                <ValidationMessage For="@(() => newProduct.Stock)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProduct.Barcode" Label="Código de barras" Variant="Variant.Outlined" For="@(() => newProduct.Barcode)" />
                <ValidationMessage For="@(() => newProduct.Barcode)" />
            </MudItem>
            <MudItem xs="12" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" class="custom-btn">Guardar</MudButton>
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>
@* TODO añadir filtros *@
@* TODO orden por defecto de más reciente a más viejo *@
@* --- Tablas (igual que antes) --- añadir filtrado *@
<MudText Typo="Typo.h5" GutterBottom="true">Productos</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@products" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        @* ... Contenido de la tabla de productos sin cambios ... *@
         <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Código de barras</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="Categoría">@context.Category</MudTd>
            <MudTd DataLabel="Stock">@context.Stock</MudTd>
            <MudTd DataLabel="Código de barras">@context.Barcode</MudTd>
            <MudTd DataLabel="Acciones">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditProduct(context)" Color="Color.Primary" Title="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => DeleteProduct(context.Id)" Color="Color.Error" Title="Eliminar" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
             <MudTablePager />
        </PagerContent>
         <NoRecordsContent>
             <MudText>No hay productos para mostrar.</MudText>
         </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudText Typo="Typo.h5" GutterBottom="true">Historial de Movimientos</MudText>
<MudPaper Class="mb-4" Elevation="1">
 <MudTable Items="@movements" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        @* ... Contenido de la tabla de movimientos sin cambios ... *@
     <HeaderContent>
         <MudTh>Fecha</MudTh>
         <MudTh>Producto ID</MudTh>
         <MudTh>Cantidad</MudTh>
         <MudTh>Tipo</MudTh>
     </HeaderContent>
     <RowTemplate>
         <MudTd DataLabel="Fecha">@context.Date.ToShortDateString()</MudTd>
         <MudTd DataLabel="Producto ID">@context.ProductId</MudTd>
         <MudTd DataLabel="Cantidad">@context.Quantity</MudTd>
         <MudTd DataLabel="Tipo">@context.Type</MudTd>
     </RowTemplate>
      <PagerContent>
             <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
             <MudText>No hay movimientos para mostrar.</MudText>
         </NoRecordsContent>
 </MudTable>
</MudPaper>

<style>
    main {
        flex: 1;
        padding: 1rem;
        background: #b3e9ff;

    }
</style>

@code {
    private Product newProduct = new();
    private IEnumerable<Product> products = new List<Product>();
    private IEnumerable<InventoryMovement> movements = new List<InventoryMovement>();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            products = await ProductService.GetProductsAsync() ?? new List<Product>();
            movements = await ProductService.GetInventoryMovementsAsync(0) ?? new List<InventoryMovement>(); // Carga todos los movimientos
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en LoadData: {ex.Message}");
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error); // Notifica al usuario
        }
        StateHasChanged(); // Necesario si LoadData se llama fuera de OnInitializedAsync
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (newProduct.Id == 0)
            {
                await ProductService.AddProductAsync(newProduct);
                Snackbar.Add("Producto añadido con éxito.", Severity.Success); // Mensaje de éxito
            }
            else
            {
                await ProductService.UpdateProductAsync(newProduct);
                Snackbar.Add("Producto actualizado con éxito.", Severity.Success); // Mensaje de éxito
            }

            newProduct = new Product(); // Limpia formulario
            await LoadData(); // Recarga datos y actualiza la UI a través de StateHasChanged dentro de LoadData
        }
        // --- INICIO: Capturar Excepción de Duplicado ---
        catch (DuplicateProductException dex)
        {
            // Muestra el mensaje específico de la excepción al usuario
            Snackbar.Add(dex.Message, Severity.Warning);
        }
        // --- FIN: Capturar Excepción de Duplicado ---
        catch (Exception ex)
        {
            // Muestra un error genérico para otras excepciones
            Console.WriteLine($"HandleValidSubmit: EXCEPCIÓN al guardar: {ex.ToString()}");
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private void HandleInvalidSubmit()
    {
        // El usuario ya ve los errores en los campos gracias a ValidationMessage/Summary
        Snackbar.Add("Por favor corrija los errores de validación.", Severity.Warning);
    }

    private void EditProduct(Product product)
    {
        newProduct = new Product
            {
                Id = product.Id,
                Name = product.Name,
                Category = product.Category,
                Stock = product.Stock,
                Barcode = product.Barcode
            };
    }

    private async Task DeleteProduct(int id)
    {
        try
        {
            await ProductService.DeleteProductAsync(id);
            Snackbar.Add("Producto eliminado.", Severity.Info); // Mensaje informativo
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"DeleteProduct: EXCEPCIÓN al eliminar ID: {id}. Error: {ex.Message}");
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }
}