        </NoRecordsContent>
    </MudTable>
</MudPaper>

<!-- Formulario para Historial de Compras -->
<MudText Typo="Typo.h5" GutterBottom="true" Class="mt-4">Registro de Historial de Compras</MudText>
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <EditForm Model="@newHistorialCompra" OnValidSubmit="@HandleHistorialCompraSubmit">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudSelect T="int" Label="Proveedor" @bind-Value="newHistorialCompra.ProveedorId" Variant="Variant.Outlined">
                    @foreach (var proveedor in proveedores)
                    {
                        <MudSelectItem Value="@proveedor.Id">@proveedor.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Value="newHistorialCompra.FechaCompra" Label="Fecha de Compra" DateFormat="dd/MM/yyyy" Editable="true" Placeholder="Seleccione una fecha" DateChanged="@((DateTime? date) => OnFechaCompraChanged(date))" AutoClose="true" DisableToolbar="false" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @(newHistorialCompra.Id == 0 ? "Registrar Historial" : "Actualizar Historial")
                </MudButton>
                @if (newHistorialCompra.Id != 0)
                {
                    <MudButton OnClick="@(() => ResetHistorialCompra())" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2">
                        Cancelar Edición
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>

<!-- Tabla de Historial de Compras -->
<MudText Typo="Typo.h5" GutterBottom="true">Historial de Compras</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@historialCompras" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh Style="width: 10%; text-align: center;">ID</MudTh>
            <MudTh Style="width: 30%; text-align: center;">Proveedor</MudTh>
            <MudTh Style="width: 30%; text-align: center;">Fecha</MudTh>
            <MudTh Style="width: 15%; text-align: center;">Productos</MudTh>
            <MudTh Style="width: 15%; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID" Style="text-align: center;">@context.Id</MudTd>
            <MudTd DataLabel="Proveedor" Style="text-align: center;">
                @ObtenerNombreProveedor(context.ProveedorId)
            </MudTd>
            <MudTd DataLabel="Fecha" Style="text-align: center;">
                @(context.FechaCompra.Year > 1 ? context.FechaCompra.ToString("dd/MM/yyyy") : "Sin Fecha")
            </MudTd>
            <MudTd DataLabel="Productos" Style="text-align: center;">@context.Productos.Count</MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditHistorialCompra(context)" Color="Color.Primary" Title="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="async () => await DeleteHistorialCompra(context.Id)" Color="Color.Error" Title="Eliminar" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay historial de compras para mostrar.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    // Variables principales
    private OrdenCompra newOrdenCompra = new()
        {
            Productos = new List<Producto>(),
        };
    private Proveedor newProveedor = new()
        {
            Id = 0,
            Nombre = string.Empty,
            Direccion = string.Empty,
            Telefono = string.Empty,
            Email = string.Empty
        };
    private ControlCredito newControlCredito = new()
        {
            Id = 0,
            ProveedorId = 0,
            CreditoDisponible = 0,
            FechaVencimiento = DateTime.Today.AddMonths(1)
        };
    private PagoProveedor newPagoProveedor = new()
        {
            Id = 0,
            ProveedorId = 0,
            Monto = 0,
            FechaPago = DateTime.Today
        };
    private HistorialCompra newHistorialCompra = new()
        {
            Id = 0,
            ProveedorId = 0,
            FechaCompra = DateTime.Today,
            Productos = new List<Producto>()
        };
    private RecepcionMercancia newRecepcionMercancia = new()
        {
            Id = 0,
            OrdenCompraId = 0,
            FechaRecepcion = DateTime.Today,
            Productos = new List<Producto>()
        };
    private Producto nuevoProducto = new()
        {
            Nombre = string.Empty,
            Precio = 0,
            Cantidad = 0
        };

    // Colecciones de datos
    private IEnumerable<Proveedor> proveedores = new List<Proveedor>();
    private IEnumerable<OrdenCompra> ordenesCompra = new List<OrdenCompra>();
    private IEnumerable<ControlCredito> controlCreditos = new List<ControlCredito>();
    private IEnumerable<PagoProveedor> pagosProveedores = new List<PagoProveedor>();
    private IEnumerable<HistorialCompra> historialCompras = new List<HistorialCompra>();
    private IEnumerable<RecepcionMercancia> recepcionMercancias = new List<RecepcionMercancia>();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            proveedores = await CompraService.GetProveedoresAsync() ?? new List<Proveedor>();
            ordenesCompra = await CompraService.GetOrdenesCompraAsync() ?? new List<OrdenCompra>();
            controlCreditos = await CompraService.GetControlCreditosAsync() ?? new List<ControlCredito>();
            pagosProveedores = await CompraService.GetPagosProveedoresAsync() ?? new List<PagoProveedor>();
            historialCompras = await CompraService.GetHistorialComprasAsync() ?? new List<HistorialCompra>();
            recepcionMercancias = await CompraService.GetRecepcionMercanciasAsync() ?? new List<RecepcionMercancia>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
    }

    // Método auxiliar para obtener nombres de proveedores
    private string ObtenerNombreProveedor(int proveedorId)
    {
        var proveedor = proveedores.FirstOrDefault(p => p.Id == proveedorId);
        return proveedor != null ? proveedor.Nombre : $"Proveedor #{proveedorId}";
    }

    #region Gestión de Productos
    private void AgregarProducto()
    {
        if (string.IsNullOrWhiteSpace(nuevoProducto.Nombre) || nuevoProducto.Precio <= 0 || nuevoProducto.Cantidad <= 0)
        {
            Snackbar.Add("Por favor complete los datos del producto correctamente.", Severity.Warning);
            return;
        }

        // Crear una copia para evitar referencias
        var producto = new Producto
            {
                Nombre = nuevoProducto.Nombre,
                Precio = nuevoProducto.Precio,
                Cantidad = nuevoProducto.Cantidad
            };

        // Agregar a la lista de la orden
        newOrdenCompra.Productos.Add(producto);

        // Limpiar para el próximo producto
        nuevoProducto = new Producto
            {
                Nombre = string.Empty,
                Precio = 0,
                Cantidad = 0
            };

        Snackbar.Add("Producto agregado a la orden", Severity.Success);
    }

    private void EliminarProducto(Producto producto)
    {
        newOrdenCompra.Productos.Remove(producto);
        Snackbar.Add("Producto eliminado de la orden", Severity.Info);
    }
    #endregion

    #region OrdenCompra
    private void EditOrdenCompra(OrdenCompra ordenCompra)
    {
        Console.WriteLine($"Fecha original para edición: {ordenCompra.FechaOrden}");

        newOrdenCompra = new OrdenCompra
            {
                Id = ordenCompra.Id,
                ProveedorId = ordenCompra.ProveedorId,
                FechaOrden = ordenCompra.FechaOrden,
                Productos = ordenCompra.Productos.Select(p => new Producto
                {
                    Nombre = p.Nombre,
                    Precio = p.Precio,
                    Cantidad = p.Cantidad
                }).ToList()
            };
    }

    private async Task DeleteOrdenCompra(int id)
    {
        try
        {
            await CompraService.DeleteOrdenCompraAsync(id);
            Snackbar.Add("Orden de compra eliminada.", Severity.Info);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (newOrdenCompra.Productos.Count == 0)
            {
                Snackbar.Add("Debe agregar al menos un producto a la orden", Severity.Warning);
                return;
            }

            var ordenAGuardar = new OrdenCompra
                {
                    Id = newOrdenCompra.Id,
                    ProveedorId = newOrdenCompra.ProveedorId,
                    FechaOrden = newOrdenCompra.FechaOrden,
                    Productos = new List<Producto>(newOrdenCompra.Productos)
                };

            Console.WriteLine($"DEBUG - FechaOrden antes de guardar: {ordenAGuardar.FechaOrden}");

            if (newOrdenCompra.Id == 0)
            {
                await CompraService.AddOrdenCompraAsync(newOrdenCompra);
                Snackbar.Add("Orden de compra añadida con éxito.", Severity.Success);
            }
            else
            {
                await CompraService.UpdateOrdenCompraAsync(newOrdenCompra);
                Snackbar.Add("Orden de compra actualizada con éxito.", Severity.Success);
            }

            newOrdenCompra = new OrdenCompra
                {
                    Productos = new List<Producto>()
                };
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private void HandleInvalidSubmit()
    {
        Snackbar.Add("Por favor corrija los errores de validación.", Severity.Warning);
    }

    private void OnDateChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            Console.WriteLine($"DEBUG - Fecha seleccionada en DatePicker: {date.Value}");
            newOrdenCompra.FechaOrden = date.Value;
        }
    }

    private void MostrarDetallesOrden(OrdenCompra orden)
    {
        // Aquí mostraríamos un diálogo con detalles de la orden
        var mensaje = $"Orden #{orden.Id}: {orden.Productos.Count} productos por un total de {orden.Productos.Sum(p => p.Precio * p.Cantidad).ToString("C")}";
        Snackbar.Add(mensaje, Severity.Info);
    }
    #endregion

    #region RecepcionMercancia
    private void CrearRecepcionDesdeOrden(OrdenCompra orden)
    {
        newRecepcionMercancia = new RecepcionMercancia
            {
                OrdenCompraId = orden.Id,
                FechaRecepcion = DateTime.Today,
                Productos = orden.Productos.Select(p => new Producto
                {
                    Nombre = p.Nombre,
                    Precio = p.Precio,
                    Cantidad = p.Cantidad
                }).ToList()
            };

        Snackbar.Add("Se ha creado una recepción basada en la orden seleccionada. Complete los detalles y guárdela.", Severity.Info);
    }

    private void EditRecepcionMercancia(RecepcionMercancia recepcion)
    {
        newRecepcionMercancia = new RecepcionMercancia
            {
                Id = recepcion.Id,
                OrdenCompraId = recepcion.OrdenCompraId,
                FechaRecepcion = recepcion.FechaRecepcion,
                Productos = recepcion.Productos.Select(p => new Producto
                {
                    Nombre = p.Nombre,
                    Precio = p.Precio,
                    Cantidad = p.Cantidad
                }).ToList()
            };
    }

    private async Task DeleteRecepcionMercancia(int id)
    {
        try
        {
            await CompraService.DeleteRecepcionMercanciaAsync(id);
            Snackbar.Add("Recepción de mercancía eliminada.", Severity.Info);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleRecepcionSubmit()
    {
        try
        {
            if (newRecepcionMercancia.OrdenCompraId <= 0)
            {
                Snackbar.Add("Debe seleccionar una orden de compra válida", Severity.Warning);
                return;
            }

            // Si no hay productos, intenta obtener los productos de la orden seleccionada
            if (newRecepcionMercancia.Productos.Count == 0)
            {
                var orden = ordenesCompra.FirstOrDefault(o => o.Id == newRecepcionMercancia.OrdenCompraId);
                if (orden != null)
                {
                    newRecepcionMercancia.Productos = orden.Productos.Select(p => new Producto
                        {
                            Nombre = p.Nombre,
                            Precio = p.Precio,
                            Cantidad = p.Cantidad
                        }).ToList();
                }
            }

            if (newRecepcionMercancia.Id == 0)
            {
                await CompraService.AddRecepcionMercanciaAsync(newRecepcionMercancia);
                Snackbar.Add("Recepción de mercancía registrada con éxito.", Severity.Success);
            }
            else
            {
                await CompraService.UpdateRecepcionMercanciaAsync(newRecepcionMercancia);
                Snackbar.Add("Recepción de mercancía actualizada con éxito.", Severity.Success);
            }

            ResetRecepcionMercancia();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private void ResetRecepcionMercancia()
    {
        newRecepcionMercancia = new RecepcionMercancia
            {
                Id = 0,
                OrdenCompraId = 0,
                FechaRecepcion = DateTime.Today,
                Productos = new List<Producto>()
            };
    }

    private void OnFechaRecepcionChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            newRecepcionMercancia.FechaRecepcion = date.Value;
        }
    }

    private void MostrarDetallesRecepcion(RecepcionMercancia recepcion)
    {
        // Aquí mostraríamos un diálogo con detalles de la recepción
        var mensaje = $"Recepción #{recepcion.Id} de Orden #{recepcion.OrdenCompraId}: {recepcion.Productos.Count} productos recibidos";
        Snackbar.Add(mensaje, Severity.Info);
    }
    #endregion

    #region Proveedor
    private void EditProveedor(Proveedor proveedor)
    {
        newProveedor = new Proveedor
            {
                Id = proveedor.Id,
                Nombre = proveedor.Nombre,
                Direccion = proveedor.Direccion,
                Telefono = proveedor.Telefono,
                Email = proveedor.Email
            };
    }

    private async Task DeleteProveedor(int id)
    {
        try
        {
            await CompraService.DeleteProveedorAsync(id);
            Snackbar.Add("Proveedor eliminado.", Severity.Info);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleProveedorSubmit()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(newProveedor.Nombre))
            {
                Snackbar.Add("El nombre del proveedor es obligatorio", Severity.Warning);
                return;
            }

            if (newProveedor.Id == 0)
            {
                await CompraService.AddProveedorAsync(newProveedor);
                Snackbar.Add("Proveedor añadido con éxito.", Severity.Success);
            }
            else
            {
                await CompraService.UpdateProveedorAsync(newProveedor);
                Snackbar.Add("Proveedor actualizado con éxito.", Severity.Success);
            }

            ResetProveedor();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private void ResetProveedor()
    {
        newProveedor = new Proveedor
            {
                Id = 0,
                Nombre = string.Empty,
                Direccion = string.Empty,
                Telefono = string.Empty,
                Email = string.Empty
            };
    }
    #endregion

    #region ControlCredito
    private void EditControlCredito(ControlCredito controlCredito)
    {
        newControlCredito = new ControlCredito
            {
                Id = controlCredito.Id,
                ProveedorId = controlCredito.ProveedorId,
                CreditoDisponible = controlCredito.CreditoDisponible,
                FechaVencimiento = controlCredito.FechaVencimiento
            };
    }

    private async Task DeleteControlCredito(int id)
    {
        try
        {
            await CompraService.DeleteControlCreditoAsync(id);
            Snackbar.Add("Control de crédito eliminado.", Severity.Info);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleControlCreditoSubmit()
    {
        try
        {
            var controlCreditoToSave = new ControlCredito
                {
                    Id = newControlCredito.Id,
                    ProveedorId = newControlCredito.ProveedorId,
                    CreditoDisponible = newControlCredito.CreditoDisponible,
                    FechaVencimiento = newControlCredito.FechaVencimiento
                };

            Console.WriteLine($"DEBUG - Fecha de Vencimiento antes de guardar: {controlCreditoToSave.FechaVencimiento}");

            if (newControlCredito.Id == 0)
            {
                await CompraService.AddControlCreditoAsync(controlCreditoToSave);
                Snackbar.Add("Control de crédito añadido con éxito.", Severity.Success);
            }
            else
            {
                await CompraService.UpdateControlCreditoAsync(controlCreditoToSave);
                Snackbar.Add("Control de crédito actualizado con éxito.", Severity.Success);
            }

            ResetControlCredito();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private void ResetControlCredito()
    {
        newControlCredito = new ControlCredito
            {
                Id = 0,
                ProveedorId = 0,
                CreditoDisponible = 0,
                FechaVencimiento = DateTime.Today.AddMonths(1)
            };
    }

    private void OnFechaVencimientoChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            Console.WriteLine($"DEBUG - Fecha de vencimiento seleccionada: {date.Value}");
            newControlCredito.FechaVencimiento = date.Value;
        }
    }
    #endregion

    #region PagoProveedor
    private void EditPagoProveedor(PagoProveedor pagoProveedor)
    {
        newPagoProveedor = new PagoProveedor
            {
                Id = pagoProveedor.Id,
                ProveedorId = pagoProveedor.ProveedorId,
                Monto = pagoProveedor.Monto,
                FechaPago = pagoProveedor.FechaPago
            };
    }

    private async Task DeletePagoProveedor(int id)
    {
        try
        {
            await CompraService.DeletePagoProveedorAsync(id);
            Snackbar.Add("Pago eliminado.", Severity.Info);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandlePagoProveedorSubmit()
    {
        try
        {
            var pagoToSave = new PagoProveedor
                {
                    Id = newPagoProveedor.Id,
                    ProveedorId = newPagoProveedor.ProveedorId,
                    Monto = newPagoProveedor.Monto,
                    FechaPago = newPagoProveedor.FechaPago
                };

            Console.WriteLine($"DEBUG - Fecha de Pago antes de guardar: {pagoToSave.FechaPago}");

            if (newPagoProveedor.Id == 0)
            {
                await CompraService.AddPagoProveedorAsync(pagoToSave);
                Snackbar.Add("Pago añadido con éxito.", Severity.Success);
            }
            else
            {
                await CompraService.UpdatePagoProveedorAsync(pagoToSave);
                Snackbar.Add("Pago actualizado con éxito.", Severity.Success);
            }

            ResetPagoProveedor();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private void ResetPagoProveedor()
    {
        newPagoProveedor = new PagoProveedor
            {
                Id = 0,
                ProveedorId = 0,
                Monto = 0,
                FechaPago = DateTime.Today
            };
    }

    private void OnFechaPagoChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            Console.WriteLine($"DEBUG - Fecha de pago seleccionada: {date.Value}");
            newPagoProveedor.FechaPago = date.Value;
        }
    }
    #endregion

    #region HistorialCompra
    private void EditHistorialCompra(HistorialCompra historialCompra)
    {
        newHistorialCompra = new HistorialCompra
            {
                Id = historialCompra.Id,
                ProveedorId = historialCompra.ProveedorId,
                FechaCompra = historialCompra.FechaCompra,
                Productos = historialCompra.Productos.Select(p => new Producto
                {
                    Nombre = p.Nombre,
                    Precio = p.Precio,
                    Cantidad = p.Cantidad
                }).ToList()
            };
    }

    private async Task DeleteHistorialCompra(int id)
    {
        try
        {
            await CompraService.DeleteHistorialCompraAsync(id);
            Snackbar.Add("Historial eliminado.", Severity.Info);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleHistorialCompraSubmit()
    {
        try
        {
            var historialToSave = new HistorialCompra
                {
                    Id = newHistorialCompra.Id,
                    ProveedorId = newHistorialCompra.ProveedorId,
                    FechaCompra = newHistorialCompra.FechaCompra,
                    Productos = new List<Producto>(newHistorialCompra.Productos)
                };

            Console.WriteLine($"DEBUG - Fecha de Compra antes de guardar: {historialToSave.FechaCompra}");

            if (newHistorialCompra.Id == 0)
            {
                await CompraService.AddHistorialCompraAsync(historialToSave);
                Snackbar.Add("Historial añadido con éxito.", Severity.Success);
            }
            else
            {
                await CompraService.UpdateHistorialCompraAsync(historialToSave);
                Snackbar.Add("Historial actualizado con éxito.", Severity.Success);
            }

            ResetHistorialCompra();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private void ResetHistorialCompra()
    {
        newHistorialCompra = new HistorialCompra
            {
                Id = 0,
                ProveedorId = 0,
                FechaCompra = DateTime.Today,
                Productos = new List<Producto>()
            };
    }

    private void OnFechaCompraChanged(DateTime? date)
    {
        if (date.HasValue)
        {
            Console.WriteLine($"DEBUG - Fecha de compra seleccionada: {date.Value}");
            newHistorialCompra.FechaCompra = date.Value;
        }
    }
    #endregion
}

<style>
    main {
        flex: 1;
        padding: 1rem;
        background: #b3e9ff;
    }
</style>