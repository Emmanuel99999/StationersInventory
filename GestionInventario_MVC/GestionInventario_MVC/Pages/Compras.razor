            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="newPagoProveedor.Monto" Label="Monto" Variant="Variant.Outlined" Format="F2" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Value="newPagoProveedor.FechaPago" Label="Fecha de Pago" DateFormat="dd/MM/yyyy" Editable="true" Placeholder="Seleccione una fecha" DateChanged="@((DateTime? date) => OnFechaPagoChanged(date))" AutoClose="true" DisableToolbar="false" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" Class="mt-4">
