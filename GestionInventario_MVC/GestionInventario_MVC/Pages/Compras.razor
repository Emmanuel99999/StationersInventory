                    @(newPagoProveedor.Id == 0 ? "Registrar Pago" : "Actualizar Pago")
                </MudButton>
                @if (newPagoProveedor.Id != 0)
                {
                    <MudButton OnClick="@(() => ResetPagoProveedor())" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2">
                        Cancelar Edición
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>

<!-- Tabla de Pagos a Proveedores -->
<MudText Typo="Typo.h5" GutterBottom="true">Pagos a Proveedores</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@pagosProveedores" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh Style="width: 10%; text-align: center;">ID</MudTh>
            <MudTh Style="width: 30%; text-align: center;">Proveedor</MudTh>
            <MudTh Style="width: 30%; text-align: center;">Monto</MudTh>
