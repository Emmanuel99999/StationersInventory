@page "/compras"
@inject ICompraService CompraService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Gestión de Compras</MudText>

<!-- REGISTRO DE PROVEEDORES -->
<MudText Typo="Typo.h5" GutterBottom="true" Class="mt-4">Registro de Proveedores</MudText>
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <EditForm Model="@newProveedor" OnValidSubmit="@HandleProveedorSubmit">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProveedor.Nombre" Label="Nombre" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProveedor.Direccion" Label="Dirección" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProveedor.Telefono" Label="Teléfono" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="newProveedor.Email" Label="Email" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Class="custom-btn">
                    @(newProveedor.Id == 0 ? "Registrar Proveedor" : "Actualizar Proveedor")
                </MudButton>
                @if (newProveedor.Id != 0)
                {
                    <MudButton OnClick="@(() => ResetProveedor())" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2">
                        Cancelar Edición
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>

<!-- Tabla de Proveedores -->
<MudText Typo="Typo.h5" GutterBottom="true">Lista de Proveedores</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@proveedores" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh Style="width: 10%; text-align: center;">ID</MudTh>
            <MudTh Style="width: 20%; text-align: center;">Nombre</MudTh>
            <MudTh Style="width: 20%; text-align: center;">Dirección</MudTh>
            <MudTh Style="width: 15%; text-align: center;">Teléfono</MudTh>
            <MudTh Style="width: 15%; text-align: center;">Email</MudTh>
            <MudTh Style="width: 20%; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID" Style="text-align: center;">@context.Id</MudTd>
            <MudTd DataLabel="Nombre" Style="text-align: center;">@context.Nombre</MudTd>
            <MudTd DataLabel="Dirección" Style="text-align: center;">@context.Direccion</MudTd>
            <MudTd DataLabel="Teléfono" Style="text-align: center;">@context.Telefono</MudTd>
            <MudTd DataLabel="Email" Style="text-align: center;">@context.Email</MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditProveedor(context)" Color="Color.Primary" Title="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="async () => await DeleteProveedor(context.Id)" Color="Color.Error" Title="Eliminar" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay proveedores registrados.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<!-- ÓRDENES DE COMPRA Y RECEPCIÓN DE MERCANCÍA (JUNTOS) -->
<MudDivider DividerType="DividerType.FullWidth" Class="my-6" />
<MudText Typo="Typo.h4" GutterBottom="true" Class="mt-4">Gestión de Órdenes y Recepción</MudText>

<!-- Formulario para agregar o editar órdenes de compra -->
<MudText Typo="Typo.h5" GutterBottom="true">Nueva Orden de Compra</MudText>
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <EditForm Model="@newOrdenCompra" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
        <DataAnnotationsValidator />

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudSelect T="int" Label="Proveedor" @bind-Value="newOrdenCompra.ProveedorId" Variant="Variant.Outlined">
                    @foreach (var proveedor in proveedores)
                    {
                        <MudSelectItem Value="@proveedor.Id">@proveedor.Nombre</MudSelectItem>
                    }
                </MudSelect>
                <ValidationMessage For="@(() => newOrdenCompra.ProveedorId)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Value="newOrdenCompra.FechaOrden" Label="Fecha de Orden" DateFormat="dd/MM/yyyy" Editable="true" Placeholder="Seleccione una fecha" DateChanged="@((DateTime? date) => OnDateChanged(date))" AutoClose="true" DisableToolbar="false" Variant="Variant.Outlined" />
                <ValidationMessage For="@(() => newOrdenCompra.FechaOrden)" />
            </MudItem>

            <!-- Nuevos campos para productos -->
            <MudItem xs="12">
                <MudText Typo="Typo.h6" GutterBottom="true" Class="mt-2">Productos</MudText>
                <MudDivider />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="nuevoProducto.Nombre" Label="Nombre del Producto" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="nuevoProducto.Precio" Label="Precio" Variant="Variant.Outlined" Format="F2" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField @bind-Value="nuevoProducto.Cantidad" Label="Cantidad" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-center mt-2">
                <MudButton OnClick="AgregarProducto" Variant="Variant.Filled" Color="Color.Secondary">Agregar Producto</MudButton>
            </MudItem>

            @if (newOrdenCompra.Productos.Any())
            {
                <MudItem xs="12" Class="mt-4">
                    <MudTable Items="@newOrdenCompra.Productos" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true">
                        <HeaderContent>
                            <MudTh>Nombre</MudTh>
                            <MudTh>Precio</MudTh>
                            <MudTh>Cantidad</MudTh>
                            <MudTh>Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="producto">
                            <MudTd DataLabel="Nombre">@producto.Nombre</MudTd>
                            <MudTd DataLabel="Precio">@producto.Precio.ToString("C")</MudTd>
                            <MudTd DataLabel="Cantidad">@producto.Cantidad</MudTd>
                            <MudTd DataLabel="Acciones">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => EliminarProducto(producto)" Color="Color.Error" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            }

            <MudItem xs="12" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Guardar Orden</MudButton>
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>

<!-- Tabla de Órdenes de Compra -->
<MudText Typo="Typo.h5" GutterBottom="true">Órdenes de Compra</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@ordenesCompra" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh Style="width: 10%; text-align: center;">ID</MudTh>
            <MudTh Style="width: 20%; text-align: center;">Proveedor</MudTh>
            <MudTh Style="width: 20%; text-align: center;">Fecha</MudTh>
            <MudTh Style="width: 20%; text-align: center;">Productos</MudTh>
            <MudTh Style="width: 30%; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID" Style="text-align: center;">@context.Id</MudTd>
            <MudTd DataLabel="Proveedor" Style="text-align: center;">
                @(ObtenerNombreProveedor(context.ProveedorId))
            </MudTd>
            <MudTd DataLabel="Fecha" Style="text-align: center;">
                @(context.FechaOrden.Year > 1 ? context.FechaOrden.ToString("dd/MM/yyyy") : "Sin Fecha")
            </MudTd>
            <MudTd DataLabel="Productos" Style="text-align: center;">
                @context.Productos.Count
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditOrdenCompra(context)" Color="Color.Primary" Title="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="async () => await DeleteOrdenCompra(context.Id)" Color="Color.Error" Title="Eliminar" />
                <MudIconButton Icon="@Icons.Material.Filled.AddBox" Size="Size.Small" OnClick="() => CrearRecepcionDesdeOrden(context)" Color="Color.Success" Title="Crear Recepción" />
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => MostrarDetallesOrden(context)" Color="Color.Info" Title="Ver Detalles" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay órdenes de compra para mostrar.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<!-- Formulario para Recepción de Mercancía -->
<MudText Typo="Typo.h5" GutterBottom="true" Class="mt-4">Nueva Recepción de Mercancía</MudText>
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <EditForm Model="@newRecepcionMercancia" OnValidSubmit="@HandleRecepcionSubmit">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudSelect T="int" Label="Orden de Compra" @bind-Value="newRecepcionMercancia.OrdenCompraId" Variant="Variant.Outlined">
                    @foreach (var orden in ordenesCompra)
                    {
                        <MudSelectItem Value="@orden.Id">Orden #@orden.Id (@ObtenerNombreProveedor(orden.ProveedorId))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Value="newRecepcionMercancia.FechaRecepcion" Label="Fecha de Recepción" DateFormat="dd/MM/yyyy" Editable="true" Placeholder="Seleccione una fecha" DateChanged="@((DateTime? date) => OnFechaRecepcionChanged(date))" AutoClose="true" DisableToolbar="false" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" Class="mt-4">
                <MudText>
                    <strong>Nota:</strong> Los productos se importarán automáticamente de la orden de compra seleccionada.
                </MudText>
            </MudItem>
            <MudItem xs="12" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @(newRecepcionMercancia.Id == 0 ? "Registrar Recepción" : "Actualizar Recepción")
                </MudButton>
                @if (newRecepcionMercancia.Id != 0)
                {
                    <MudButton OnClick="@(() => ResetRecepcionMercancia())" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2">
                        Cancelar Edición
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>

<!-- Tabla de Recepción de Mercancía -->
<MudText Typo="Typo.h5" GutterBottom="true">Recepción de Mercancía</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@recepcionMercancias" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh Style="width: 10%; text-align: center;">ID</MudTh>
            <MudTh Style="width: 30%; text-align: center;">Orden de Compra</MudTh>
            <MudTh Style="width: 30%; text-align: center;">Fecha</MudTh>
            <MudTh Style="width: 15%; text-align: center;">Productos</MudTh>
            <MudTh Style="width: 15%; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID" Style="text-align: center;">@context.Id</MudTd>
            <MudTd DataLabel="Orden de Compra" Style="text-align: center;">
                @context.OrdenCompraId
            </MudTd>
            <MudTd DataLabel="Fecha" Style="text-align: center;">
                @(context.FechaRecepcion.Year > 1 ? context.FechaRecepcion.ToString("dd/MM/yyyy") : "Sin Fecha")
            </MudTd>
            <MudTd DataLabel="Productos" Style="text-align: center;">
                @context.Productos.Count
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditRecepcionMercancia(context)" Color="Color.Primary" Title="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="async () => await DeleteRecepcionMercancia(context.Id)" Color="Color.Error" Title="Eliminar" />
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="() => MostrarDetallesRecepcion(context)" Color="Color.Info" Title="Ver Detalles" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay recepciones de mercancía para mostrar.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<!-- OTRAS SECCIONES -->
<MudDivider DividerType="DividerType.FullWidth" Class="my-6" />

<!-- Formulario para Control de Crédito y Plazos de Pago -->
<MudText Typo="Typo.h5" GutterBottom="true" Class="mt-4">Control de Crédito y Plazos de Pago</MudText>
<MudPaper Class="pa-4 mb-4" Elevation="1">
    <EditForm Model="@newControlCredito" OnValidSubmit="@HandleControlCreditoSubmit">
        <DataAnnotationsValidator />
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudSelect T="int" Label="Proveedor" @bind-Value="newControlCredito.ProveedorId" Variant="Variant.Outlined">
                    @foreach (var proveedor in proveedores)
                    {
                        <MudSelectItem Value="@proveedor.Id">@proveedor.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="newControlCredito.CreditoDisponible" Label="Crédito Disponible" Variant="Variant.Outlined" Format="F2" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Value="newControlCredito.FechaVencimiento" Label="Fecha de Vencimiento" DateFormat="dd/MM/yyyy" Editable="true" Placeholder="Seleccione una fecha" DateChanged="@((DateTime? date) => OnFechaVencimientoChanged(date))" AutoClose="true" DisableToolbar="false" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" Class="mt-4">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @(newControlCredito.Id == 0 ? "Registrar Control de Crédito" : "Actualizar Control de Crédito")
                </MudButton>
                @if (newControlCredito.Id != 0)
                {
                    <MudButton OnClick="@(() => ResetControlCredito())" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-2">
                        Cancelar Edición
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
        <ValidationSummary />
    </EditForm>
</MudPaper>

<!-- Tabla de Control de Crédito -->
<MudText Typo="Typo.h5" GutterBottom="true">Control de Crédito</MudText>
<MudPaper Class="mb-4" Elevation="1">
    <MudTable Items="@controlCreditos" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
        <HeaderContent>
            <MudTh Style="width: 10%; text-align: center;">ID</MudTh>
            <MudTh Style="width: 25%; text-align: center;">Proveedor</MudTh>
            <MudTh Style="width: 25%; text-align: center;">Crédito Disponible</MudTh>
            <MudTh Style="width: 25%; text-align: center;">Fecha de Vencimiento</MudTh>
            <MudTh Style="width: 15%; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID" Style="text-align: center;">@context.Id</MudTd>
            <MudTd DataLabel="Proveedor" Style="text-align: center;">
                @ObtenerNombreProveedor(context.ProveedorId)
            </MudTd>
            <MudTd DataLabel="Crédito Disponible" Style="text-align: center;">@context.CreditoDisponible.ToString("C")</MudTd>
            <MudTd DataLabel="Fecha de Vencimiento" Style="text-align: center;">
                @(context.FechaVencimiento.Year > 1 ? context.FechaVencimiento.ToString("dd/MM/yyyy") : "Sin Fecha")
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditControlCredito(context)" Color="Color.Primary" Title="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="async () => await DeleteControlCredito(context.Id)" Color="Color.Error" Title="Eliminar" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText>No hay datos de crédito para mostrar.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<!-- Formulario para Pagos a Proveedores -->
<MudText Typo="Typo.h5" GutterBottom="true" Class="mt-4">Registro de Pagos a Proveedores</MudText>
