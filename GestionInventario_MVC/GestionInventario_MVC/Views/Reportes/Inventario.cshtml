@model IEnumerable<GestionInventario_MVC.Models.InventarioItem>

    @{
        ViewData["Title"] = "Reporte de Inventario";
    }

    <h2>@ViewData["Title"]</h2>

    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>@item.Categoria</td>
                    <td>@item.Cantidad</td>
                </tr>
            }
        </tbody>
    </table>
