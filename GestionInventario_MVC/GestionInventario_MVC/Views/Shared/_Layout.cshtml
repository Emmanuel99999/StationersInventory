<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión Inventario Papelería</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-box-seam"></i> StationersInventory
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active-nav" href="/">
                                <i class="bi bi-house-door"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Privacy">
                                <i class="bi bi-shield-lock"></i> Privacidad
                            </a>
                        </li>

                    </ul>

                    <!-- Ejemplo de enlaces de login tradicionales -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="/inventory" class="btn btn-primary me-2">Inventario</a>
                        <a href="/compras" class="btn btn-primary me-2">Compras</a>
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                Reportes
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a href="/Reportes/Ventas" class="dropdown-item">
                                        <i class="bi bi-receipt"></i> Reporte de Ventas
                                    </a>
                                </li>
                                <li>
                                    <a href="/Reportes/Compras" class="dropdown-item">
                                        <i class="bi bi-cart-check"></i> Reporte de Compras
                                    </a>
                                </li>
                                <li>
                                    <a href="/Reportes/Inventario" class="dropdown-item">
                                        <i class="bi bi-box-seam"></i> Reporte de Inventario
                                    </a>
                                </li>
                                <li>
                                    <a href="/Analisis/ProductosMasVendidos" class="dropdown-item">
                                        <i class="bi bi-box-seam"></i> Productos más vendidos
                                    </a>
                                </li>
                                <li>
                                    <a href="/Estadisticas/GraficosTendencia" class="dropdown-item">
                                        <i class="bi bi-box-seam"></i> Gráficos de tendencias
                                    </a>
                                </li>

                            </ul>
                        </div>
                        <a href="/home/logout" class="btn btn-primary me-2">Cerrar sesión</a>

                    }
                    else
                    {
                        <a href="/Users/Login" class="btn btn-primary me-2">Iniciar Sesión</a>
                        <a href="/Users/Register" class="btn btn-outline-light">Registrarse</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="d-flex">

    </div>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            <div class="main-container">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="footer mt-auto py-3">
        <div class="container text-center">
            &copy; 2023 - Gestión Inventario Papelería -
            <a href="/Home/Privacy">Política de Privacidad</a>
        </div>
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>

    <script>
        // Efecto hover para botones
        $(document).ready(function() {
            $('.btn').hover(
                function() {
                    $(this).css('transform', 'translateY(-2px)');
                },
                function() {
                    $(this).css('transform', 'translateY(0)');
                }
            );

            // Resaltar enlace activo
            const currentPath = window.location.pathname;
            $('.nav-link').each(function() {
                if ($(this).attr('href') === currentPath) {
                    $(this).addClass('active-nav');
                }
            });
        });
    </script>
    <script>
        // Redirigir si ya está autenticado
        document.addEventListener('DOMContentLoaded', () => {
            const token = localStorage.getItem('jwtToken') || sessionStorage.getItem('jwtToken');
            if (token && window.location.pathname.toLowerCase() === '/account/login') {
                window.location.href = '/';
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>