@{
    ViewData["Title"] = "Gestión de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Estilo principal */
    .welcome-container {
        background-color: #0a192f; /* Azul muy oscuro */
        color: white;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        text-align: center;
    }

    /* Botón de inicio de sesión centrado */
    .login-btn-container {
        width: 100%;
        margin: 2rem 0;
        display: flex;
        justify-content: center;
    }

    .login-btn {
        padding: 12px 30px;
        background-color: #64ffda;
        color: #0a192f;
        border: none;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        font-size: 1.1rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .login-btn:hover {
            background-color: #52e0c4;
            transform: translateY(-3px);
            box-shadow: 0 7px 20px rgba(100, 255, 218, 0.4);
        }

    .display-4 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: white;
        animation: fadeIn 1.5s ease-in-out;
    }

    .welcome-text {
        font-size: 1.2rem;
        max-width: 800px;
        margin-bottom: 1rem;
        opacity: 0.9;
    }

    /* Sección de beneficios para papelería */
    .features-section {
        margin-top: 1rem;
        width: 100%;
        max-width: 1000px;
    }

    .features-title {
        font-size: 1.8rem;
        margin-bottom: 2rem;
        color: #64ffda;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    .feature-card {
        background: rgba(100, 255, 218, 0.1);
        border: 1px solid #64ffda;
        border-radius: 8px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        opacity: 0;
        transform: translateY(20px);
    }

        .feature-card:nth-child(1) {
            animation: fadeInUp 0.8s 0.2s forwards;
        }

        .feature-card:nth-child(2) {
            animation: fadeInUp 0.8s 0.4s forwards;
        }

        .feature-card:nth-child(3) {
            animation: fadeInUp 0.8s 0.6s forwards;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(100, 255, 218, 0.2);
        }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #64ffda;
    }

    .feature-title {
        font-size: 1.3rem;
        margin-bottom: 0.8rem;
    }

    .feature-description {
        font-size: 0.95rem;
        opacity: 0.8;
    }

    /* Animaciones */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Enlace */
    a {
        color: #64ffda;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        a:hover {
            color: white;
            text-decoration: underline;
        }
</style>

<div class="welcome-container">
    <h1 class="display-4">Sistema de Gestión para Papelerías</h1>
    <p class="welcome-text">Controla tu inventario de manera eficiente y optimiza tus procesos.Conoce más sobre nuestro sistema</a>.</p>


    <div class="features-section">
        <h2 class="features-title">Características Principales</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">📦</div>
                <h3 class="feature-title">Control de Inventario</h3>
                <p class="feature-description">Registro en tiempo real de entradas, salidas y stock disponible de todos tus productos.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3 class="feature-title">Reportes Detallados</h3>
                <p class="feature-description">Genera reportes de ventas, productos más vendidos y niveles de inventario.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔔</div>
                <h3 class="feature-title">Alertas Automáticas</h3>
                <p class="feature-description">Notificaciones cuando los productos están por agotarse o tienen movimiento bajo.</p>
            </div>
        </div>
    </div>
</div>