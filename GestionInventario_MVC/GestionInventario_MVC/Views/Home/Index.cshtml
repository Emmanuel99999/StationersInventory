@{
    ViewData["Title"] = "Gestión de Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Referencia al archivo CSS -->
<link rel="stylesheet" href="~/css/start.css" />

<div class="welcome-container">
    <h1 class="display-4">Sistema de Gestión para Papelerías</h1>
    <p class="welcome-text">Controla tu inventario de manera eficiente y optimiza tus procesos.Conoce más sobre nuestro sistema</a>.</p>


    <div class="features-section">
        <h2 class="features-title">Características Principales</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">📦</div>
                <h3 class="feature-title">Control de Inventario</h3>
                <p class="feature-description">Registro en tiempo real de entradas, salidas y stock disponible de todos tus productos.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3 class="feature-title">Reportes Detallados</h3>
                <p class="feature-description">Genera reportes de ventas, productos más vendidos y niveles de inventario.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔔</div>
                <h3 class="feature-title">Alertas Automáticas</h3>
                <p class="feature-description">Notificaciones cuando los productos están por agotarse o tienen movimiento bajo.</p>
            </div>
        </div>
    </div>
</div>