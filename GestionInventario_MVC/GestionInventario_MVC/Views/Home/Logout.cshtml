@{
    Layout = null; // Opcional: evita el layout global para hacerlo más limpio
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Salir de la aplicación</title>
</head>
<body>
    <!-- Formulario oculto de logout POST -->
    <form id="logoutForm" asp-controller="Home" asp-action="Logout" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- Mensaje opcional mientras se cierra sesión -->
    <div style="text-align:center; margin-top:2em;">
        <h2>Cerrando sesión...</h2>
        <p>Por favor espera unos segundos.</p>
    </div>

    <!-- Script para enviar el formulario automáticamente al cargar la página -->
    <script>
        document.getElementById('logoutForm').submit();
    </script>
</body>
</html>