@{
    ViewData["Title"] = "Home";
}
@*#072AC8  (Azul oscuro)
#1E96FC  (Azul medio)
#A2D6F9  (Azul claro)
#FCF300  (Amarillo brillante)
#FFC600  (Amarillo cálido)\
#FFD700 (Amarillo mas oscuro)
*@
<style>
    body {
        background: linear-gradient(#1E96FC, #A2D6F9);
    }

    .hero {
        background: none;
        color: white;
        padding: 80px 20px;
        text-align: center;
        border-radius: 10px;
        margin-bottom: 30px;
    }

        .hero h1 {
            font-size: 3rem;
            font-weight: bold;
        }

        .hero p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

    .custom-button {
        background-color: #FCF300;
        border-radius: 10px;
        padding: 15px 30px;
        font-size: 1.2rem;
        font-weight: bold;
        text-decoration: none;
        color: white;
        border: none;
    }

        .custom-button:hover {
            background-color: #FFC600;
        }

    .features {
        text-align: center;
        margin-top: 40px;
    }

    .feature-box {
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px #072AC8;
        background-color: #1E96FC;
        transition: transform 0.3s ease-in-out;
    }

        .feature-box:hover {
            transform: scale(1.05);
        }
</style>

<div class="container">
    <div class="hero">
        <h1>📦 Welcome to Stationer's Inventory</h1>
        <p>Manage and track your stock easily with our powerful inventory system.</p>
        <a class="btn btn-success custom-button" href="/Inventario">Go to Inventory</a>
    </div>

    <div class="row features">
        <div class="col-md-4">
            <div class="feature-box p-4">
                <h3 style="color:white;">📊 Stock Tracking</h3>
                <p style="color:#FCF300">Keep track of your items in real-time.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box p-4">
                <h3 style="color:white;">⚡ Fast & Efficient</h3>
                <p style="color:#FCF300">Quickly update your inventory with ease.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-box p-4">
                <h3 style="color:white;">🔒 Secure System</h3>
                <p style="color:#FCF300 ">Only authorized users can make changes.</p>
            </div>
        </div>
    </div>
</div>