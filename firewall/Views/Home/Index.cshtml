            hardware: { title: "Firewalls de Hardware", description: "Dispositivos físicos dedicados, optimizados para alto rendimiento y robustez. Se ubican en el perímetro de la red o entre segmentos importantes. Protegen todos los dispositivos detrás de ellos." },
            software: { title: "Firewalls de Software", description: "Aplicaciones que se ejecutan en servidores o hosts. Los basados en host protegen el dispositivo individual. Los basados en servidor pueden proteger un segmento de red. Más flexibles, costo inicial menor si se usa hardware existente." },
            packet_filtering: { title: "Filtrado de Paquetes (Stateless)", description: "Primera generación. Operan en Capas 3 y 4. Decisiones basadas en encabezados IP/puerto. Rápidos, pero seguridad limitada al no ser conscientes del estado de la conexión." },
            stateful_inspection: { title: "Inspección de Estado (Stateful - SPI)", description: "Rastrean el estado de conexiones activas. Decisiones más inteligentes y contextuales. Más seguros que stateless, base de firewalls modernos." },
            proxy: { title: "Proxy (Gateway a Nivel de Aplicación - ALG)", description: "Operan en Capa 7. Actúan como intermediarios para aplicaciones específicas (HTTP, FTP). Inspección profunda del contenido. Alto nivel de seguridad, pero pueden introducir latencia." },
            ngfw: { title: "Próxima Generación (NGFW)", description: "Multifuncionales: Stateful, DPI, IPS, Control de Aplicaciones, Inteligencia de Amenazas, Sandboxing, VPN, Filtrado URL, Inspección SSL. Protección integral contra amenazas modernas." },
            waf: { title: "Firewalls de Aplicaciones Web (WAF)", description: "Especializados en proteger aplicaciones y servidores web contra ataques de Capa 7 (SQLi, XSS). Pueden ser hardware, software o servicios en la nube." },
            sdwan: { title: "Firewalls SD-WAN", description: "Integran seguridad de firewall en la arquitectura SD-WAN. Conectividad segura y optimizada para sucursales y remotos, con gestión centralizada." }
