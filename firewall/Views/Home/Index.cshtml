                document.execCommand('copy');
                button.innerText = '¡Copiado!';
                setTimeout(() => {
                    button.innerText = 'Copiar';
                }, 2000);
            } catch (err) {
                console.error('Error al copiar el código: ', err);
                button.innerText = 'Error';
                 setTimeout(() => {
                    button.innerText = 'Copiar';
                }, 2000);
            }
            document.body.removeChild(textArea);
