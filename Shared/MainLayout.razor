@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor 

<PageTitle>GestionInventario_MVC</PageTitle>

@* --- INICIO: AÑADIR PROVEEDORES MUD BLAZOR --- *@
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider /> @* <-- EL QUE FALTABA *@
@* --- FIN: AÑADIR PROVEEDORES MUD BLAZOR --- *@

<div class="page">
    <div class="sidebar">
        <nav>
            <ul>
                <li>
                    <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                </li>
                <li>
                    <NavLink href="/inventory">Inventario</NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="/compras">
                        <span class="oi oi-cart" aria-hidden="true"></span> Compras</NavLink>
                </li>
            </ul>
        </nav>
    </div>
    <main>
        <article>
            @Body
        </article>
    </main>
</div>

@* Los estilos CSS permanecen igual que en la versión anterior *@
<style>
    .page {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
    }

    .sidebar {
        width: 200px;
        background-color: #f8f9fa;
        padding: 1rem;
        border-right: 1px solid #dee2e6;
    }

        .sidebar nav ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar nav li {
            margin-bottom: 0.5rem;
        }

            .sidebar nav li .nav-link {
                display: block;
                padding: 0.25rem 0;
                color: #212529;
                text-decoration: none;
                border-radius: 4px;
                padding-left: 0.5rem;
            }

                .sidebar nav li .nav-link.active {
                    color: #0d6efd;
                    background-color: #e7f1ff;
                    font-weight: bold;
                }

                .sidebar nav li .nav-link:not(.active):hover {
                    background-color: #e9ecef;
                    color: #0056b3;
                }

    main {
        flex: 1;
        padding: 1rem;
        background-color: #ffffff;
    }

    article {
        padding: 1rem;
    }
</style>



